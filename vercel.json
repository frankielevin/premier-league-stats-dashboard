{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "h2h.py",
      "use": "@vercel/python"
    },
    {
      "src": "leaderboard.py",
      "use": "@vercel/python"
    },
    {
      "src": "form_fixtures.py",
      "use": "@vercel/python"
    },
    {
      "src": "standings.py",
      "use": "@vercel/python"
    },
    {
      "src": "web.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://premier-league-stats-dashboard.vercel.app/championship/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web.py"
    }
  ]
}
